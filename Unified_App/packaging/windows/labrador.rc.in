// Windows resources for labrador.exe (configured by CMake, see CMakeLists.txt).
#include <windows.h>

// Resource id 1: the icon Explorer / the taskbar / shortcuts show.
1 ICON "@LABRADOR_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "EspoTek"
            VALUE "FileDescription",  "EspoTek Labrador Unified App (Beta)"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "labrador"
            VALUE "OriginalFilename", "labrador.exe"
            VALUE "ProductName",      "EspoTek Labrador Unified App"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
